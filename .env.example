# --- Обязательные ---
# PostgreSQL. На Railway: добавьте сервис Postgres и подставьте ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Токен Telegram-бота от @BotFather (он рассылает сообщения подписчикам)
TELEGRAM_BOT_TOKEN=

# --- Подключение MAX (от вашего аккаунта, НЕ бота) ---
# Способ 1 (рекомендуемый): без переменных — войдите по номеру телефона в веб-панели
# (SMS-код). Токен будет храниться только в памяти сервера.
# Способ 2 (автовход после рестартов): задайте токен сессии аккаунта напрямую.
MAX_ACCOUNT_TOKEN=
# UUID устройства (пусто = сгенерируется; для стабильности сессии задайте свой)
MAX_DEVICE_ID=

# --- Опциональные ---
# chat_id конкретной группы MAX. Пусто = пересылать все группы и каналы.
# Удобнее задать в панели — там появляется список ваших чатов.
MAX_CHAT_ID=
# Секрет для веб-панели (кнопки управления + вход в MAX). Пусто = панель открыта!
ADMIN_SECRET=
# Эндпоинт приватного WS-протокола MAX (по умолчанию веб-версия)
MAX_WS_URL=wss://ws-api.oneme.ru/websocket
