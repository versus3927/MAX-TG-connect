# --- Обязательные ---
# PostgreSQL. На Railway: добавьте сервис Postgres и подставьте ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Токен Telegram-бота от @BotFather (он рассылает сообщения подписчикам)
TELEGRAM_BOT_TOKEN=
# Токен бота-приёмника в MAX (состоит в вашей группе и читает её)
MAX_BOT_TOKEN=

# --- Опциональные ---
# chat_id конкретной группы MAX. Пусто = пересылать из всех групп, где есть бот.
# Можно задать потом в веб-панели.
MAX_CHAT_ID=
# Секрет для веб-панели (кнопки управления). Пусто = панель открыта.
ADMIN_SECRET=
# Базовый URL Bot API MAX (по умолчанию official endpoint)
MAX_API_BASE=https://platform-api2.max.ru
